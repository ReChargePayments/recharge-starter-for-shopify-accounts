/**
 * Environment configuration
 * 
 * Copy this file to env.ts and update the values as needed.
 * The env.ts file is gitignored and should not be committed.
 */

export const env = {
  /**
   * Your Shopify store domain (e.g., your-store.myshopify.com)
   * This is used as a fallback when shopify.settings.value?.store_url is not available
   */
  STORE_DOMAIN: 'your-store.myshopify.com',

  /**
   * The public endpoint that provides a valid Recharge JWT
   * This is used as a fallback when shopify.settings.value?.auth_api_url is not available
   */
  RECHARGE_JWT_API_URL: 'https://your-recharge-jwt-endpoint.com/generate_recharge_jwt',

  /**
   * Recharge app name identifier
   */
  RECHARGE_APP_NAME: 'your-app-name',

  /**
   * Recharge app version
   */
  RECHARGE_APP_VERSION: '1.0.0',
} as const;
